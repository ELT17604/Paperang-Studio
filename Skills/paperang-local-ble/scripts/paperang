#!/bin/zsh
set -eu
skill_dir=${0:A:h}
repo=${skill_dir:h:h:h}
if [[ ${1:-} == --version && $# == 1 ]]; then
    cat "$skill_dir/../VERSION"
    exit
fi
build=$(mktemp -d)
trap 'rm -rf -- "$build"' EXIT
swiftc -module-cache-path "$build/modules" -Xlinker -sectcreate -Xlinker __TEXT -Xlinker __info_plist -Xlinker "$skill_dir/Info.plist" -module-name PaperangDirect "$skill_dir/Direct.swift" "$repo/Sources/ProtocolCore/Protocol.swift" "$repo/Sources/PrintCore/Renderer.swift" "$repo/Sources/PrintCore/Settings.swift" -o "$build/paperang"
"$build/paperang" "$@"
