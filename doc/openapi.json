                "properties": {
                  "lines": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2000
                  },
                  "allowPaper": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted or completed; does not prove mechanical completion",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "acknowledged": {
                      "type": "boolean"
                    },
                    "lines": {
                      "type": "integer"
                    },
