  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Settings": {
        "type": "object",
        "description": "Partial PrintSettings, unspecified fields use documented defaults, not current GUI values. Unknown keys rejected.",
        "additionalProperties": false,
        "properties": {
          "fontName": {
            "type": "string"
          },
          "alignment": {
            "type": "string",
            "enum": [
              "居左",
              "居中",
              "居右"
            ]
          },
          "imageFit": {
            "type": "string",
            "enum": [
              "适配宽度",
              "保持像素",
              "裁切填满"
            ]
          },
          "conversion": {
            "type": "string",
            "enum": [
              "阈值",
              "Floyd–Steinberg",
              "有序抖动"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1
          },
          "marginX": {
            "type": "integer",
            "minimum": 0,
            "maximum": 120
          },
          "marginY": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200
          },
          "contentWidth": {
            "type": "integer",
            "minimum": 48,
            "maximum": 576
          },
          "cropHeight": {
            "type": "integer",
            "minimum": 24,
            "maximum": 1400
          },
          "density": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "copies": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "feedBefore": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000
          },
          "feedAfter": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000
          },
          "packetBytes": {
            "type": "integer",
            "minimum": 72,
            "maximum": 1008,
            "multipleOf": 72
          },
          "bleChunk": {
            "type": "integer",
            "minimum": 20,
            "maximum": 180
          },
          "writePauseMS": {
            "type": "integer",
            "minimum": 5,
            "maximum": 200,
            "default": 10
          },
          "framePauseMS": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000,
            "default": 0
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 3,
            "maximum": 30
          },
          "finishWaitSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15
          },
          "rotation": {
            "type": "integer",
            "enum": [
              0,
              90,
              180,
              270
            ]
          },
          "fontSize": {
            "type": "number",
            "minimum": 8,
            "maximum": 96
          },
          "lineSpacing": {
            "type": "number",
            "minimum": 0,
            "maximum": 40
          },
          "threshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 255
          },
          "brightness": {
            "type": "number",
            "minimum": -100,
            "maximum": 100
          },
          "contrast": {
            "type": "number",
            "minimum": 0.2,
            "maximum": 3
          },
          "gamma": {
            "type": "number",
            "minimum": 0.2,
            "maximum": 3
          },
          "bold": {
            "type": "boolean"
          },
          "invert": {
            "type": "boolean"
          },
          "feedBetweenCopies": {
            "type": "boolean"
          }
        }
      },
      "RenderInput": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 10000
          },
          "imageBase64": {
            "type": "string",
            "description": "Base64 image bytes; not a URL or file path"
          },
          "settings": {
            "$ref": "#/components/schemas/Settings"
          },
          "title": {
            "type": "string"
          },
          "allowPaper": {
            "type": "boolean",
            "default": false,
            "description": "Network job consent: required true in normal mode; may be omitted in active tray mode; explicit false always refuses."
          },
          "includeRaw": {
            "type": "boolean",
            "default": false
          }
        },
        "oneOf": [
          {
            "required": [
              "text"
            ],
            "not": {
              "required": [
                "imageBase64"
              ]
            }
          },
          {
            "required": [
              "imageBase64"
            ],
            "not": {
              "required": [
                "text"
              ]
            }
          }
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Reading": {
        "type": "object",
        "properties": {
          "command": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "rawHex": {
            "type": "string"
          },
          "sampledAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Status": {
        "type": "object",
        "properties": {
          "apiVersion": {
            "type": "string",
            "enum": [
              "v2"
            ]
          },
          "connected": {
            "type": "boolean"
          },
          "busy": {
            "type": "boolean"
          },
          "printer": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "lastError": {
            "type": "string"
          },
          "progress": {
            "type": "number"
          },
          "jobStatus": {
            "type": "string"
          },
          "charging": {
            "type": "string",
            "enum": [
              "unknown"
            ]
          },
          "readings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Reading"
            }
          },
          "printingEnabled": {
            "type": "boolean"
          }
        }
      },
      "Device": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "rssi": {
            "type": "integer"
          },
          "paperangCandidate": {
            "type": "boolean"
          }
        }
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "printing",
              "sent",
              "unknown",
              "cancelled"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "stateLabel": {
            "type": "string"
          },
          "physicalCompletion": {
            "type": "string",
            "enum": [
              "unknown"
            ]
          }
        },
        "required": [
          "id",
          "state",
          "stateLabel",
          "physicalCompletion",
          "createdAt"
        ]
      },
      "RenderResult": {
        "type": "object",
        "properties": {
          "width": {
            "type": "integer",
            "enum": [
              576
            ]
          },
          "height": {
            "type": "integer"
          },
          "bytes": {
            "type": "integer"
          },
          "previewPngBase64": {
            "type": "string",
            "format": "byte"
          },
          "rawBase64": {
            "type": "string",
            "format": "byte"
          }
        },
        "required": [
          "width",
          "height",
          "bytes",
          "previewPngBase64"
        ]
      },
      "Log": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "type": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "ProtocolCommand": {
        "type": "object",
        "properties": {
          "command": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "expectedResponse": {
            "type": "integer",
            "nullable": true
          }
        }
      }
    }
  }
}
